{
  "name": "dsh-guard",
  "version": "0.1.2",
  "description": "DSH runtime guard: stuck sessions, token burn with no progress, and stale state left behind by a dead process",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "test"
  ],
  "scripts": {
    "test": "node test/run.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "guard",
    "watchdog",
    "observability"
  ],
  "license": "MIT"
}
